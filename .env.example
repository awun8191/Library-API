# Local development values only. Copy to .env and adjust. Never commit a real .env.
POSTGRES_DB=buildlab
POSTGRES_USER=buildlab
POSTGRES_PASSWORD=buildlab_dev_password
POSTGRES_PORT=5432

# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://buildlab:buildlab_dev_password@localhost:5432/buildlab

# Signing key for the access tokens. Use at least 32 characters. Change it outside development.
SECRET_KEY=dev-only-secret-key-change-me-please-32

# Access token settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma separated list of allowed browser origins. Use * for development only.
CORS_ALLOW_ORIGINS=*

# Largest PDF upload accepted, in megabytes
MAX_UPLOAD_SIZE_MB=20

# PDF storage directory. The database keeps only the file name.
STORAGE_DIR=Storage

# Rate limiting. Turn it off only for a local load test.
RATE_LIMIT_ENABLED=true
# Counters in PostgreSQL survive a restart. Use memory for one worker only.
RATE_LIMIT_BACKEND=postgres
# Requests per client on a route without its own rule, for one minute.
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Login attempts per client, for one minute.
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Signup requests per client, for one hour.
RATE_LIMIT_SIGNUP_PER_HOUR=5
# Upload requests per client, for one hour.
RATE_LIMIT_UPLOAD_PER_HOUR=30
# Set to true only behind a proxy that overwrites X-Real-IP or X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Set to true to write JSON logs in development as well.
LOG_JSON=false
