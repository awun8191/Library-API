# Local development values only. Copy to .env and adjust. Never commit a real .env.
POSTGRES_DB=buildlab
POSTGRES_USER=buildlab
POSTGRES_PASSWORD=buildlab_dev_password
POSTGRES_PORT=5432

# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://buildlab:buildlab_dev_password@localhost:5432/buildlab

SECRET_KEY=change-me-dev-only
