  "info": {
    "description": "A simple library API that uses a domain driven architecture for clear separation",
    "summary": "A simple library API",
    "title": "Library API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Authenticate a user and return an access token.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Authentication successful"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "403": {
            "description": "Account is inactive"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many login requests"
          }
        },
        "summary": "Get an auth token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "description": "Create a new user account.",
        "operationId": "signup_api_v1_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Account created successfully"
          },
          "400": {
            "description": "Invalid request data"
          },
          "404": {
            "description": "Department not found"
          },
          "409": {
            "description": "An account with this email already exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many signup requests"
          }
        },
        "summary": "Create an account",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/books": {
      "get": {
        "description": "List books that match the search term and the filters.",
        "operationId": "list_books_api_v1_books_get",
        "parameters": [
          {
            "description": "Search term for book name",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search term for book name",
              "title": "Q"
            }
          },
          {
            "description": "Filter by department ID",
            "in": "query",
            "name": "department_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by department ID",
              "title": "Department Id"
            }
          },
          {
            "description": "Filter by course code",
            "in": "query",
            "name": "course_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by course code",
              "title": "Course Code"
            }
          },
          {
            "description": "Cursor from the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cursor from the previous page",
              "title": "Cursor"
            }
          },
          {
            "description": "Items per page",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "description": "Items per page",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookListResponse"
                }
              }
            },
            "description": "Books fetched successfully"
          },
          "400": {
            "description": "Invalid request data"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List books with search, filters, and cursor pagination",
        "tags": [
          "Books"
        ]
      },
      "post": {
        "description": "Upload a course material PDF (Admin only).",
        "operationId": "upload_book_api_v1_books_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_book_api_v1_books_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            },
            "description": "Book uploaded successfully"
          },
          "400": {
            "description": "Invalid request data or invalid file type"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden (Admin only)"
          },
          "404": {
            "description": "Department not found"
          },
          "409": {
            "description": "Conflict (Duplicate file hash)"
          },
          "413": {
            "description": "File is larger than the upload limit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many upload requests"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload a book (PDF)",
        "tags": [
          "Books"
        ]
      }
    },
